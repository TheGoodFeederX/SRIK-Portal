# ---- Server (never expose through VITE_*) ----
# Neon PostgreSQL pooled connection string (use the branch matching the environment)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Managed Better Auth base URL for the same Neon branch
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth
# Comma separated allowed browser origins for the API
CORS_ORIGINS=http://localhost:5173

# ---- Browser (safe to bundle) ----
VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth
