# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Secret used to sign session tokens (>= 32 chars)
AUTH_SECRET=change-me-32-chars-minimum-secret
# Comma separated allowed browser origins for the API
CORS_ORIGINS=http://localhost:5173
# Optional: bootstrap admin created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@srik.local
SEED_ADMIN_PASSWORD=Admin12345!
