    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.38.3"
  }
}
