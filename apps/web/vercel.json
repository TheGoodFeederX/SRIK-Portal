{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @srik/web build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/neonauth/:path*",
      "destination": "/api/neonauth?p=:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/handler"
    },
    {
      "source": "/api/v1",
      "destination": "/api/handler"
    },
    {
      "source": "/((?!api/|neonauth/).*)",
      "destination": "/index.html"
    }
  ]
}
